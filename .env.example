# copy to .env for docker compose; values are local-only and not secrets

# --- shared by compose and the api ---
POSTGRES_USER=wager
POSTGRES_PASSWORD=wager
POSTGRES_DB=wager

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- api ---
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=25s

# per-caller token bucket (per instance)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

DATABASE_URL=postgres://wager:wager@postgres:5432/wager?sslmode=disable
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=10s
MIGRATE_ON_START=false

# tokens carry the public issuer; the JWKS is fetched through the docker network
OIDC_ISSUER=http://localhost:8180/realms/wager
OIDC_JWKS_URL=http://keycloak:8080/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-api

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_INBOUND_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/wallet-events.fifo
SQS_WORKERS=2
SQS_VISIBILITY_TIMEOUT=30
SQS_MAX_RECEIVE_COUNT=5
CONSUMER_ENABLED=true

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s

REFERENCE_MAX_ATTEMPTS=6
REFERENCE_BASE_BACKOFF=2s
REFERENCE_MAX_BACKOFF=2m
REFERENCE_POLL_INTERVAL=1s

# --- used by `make token` and the integration tests, from the host ---
KEYCLOAK_URL=http://localhost:8180
